---
const SB_URL = "https://mlkdphygsdfcanztbtez.supabase.co";
const SB_KEY = "sb_publishable_yodMR9SylDv9tF51Y7q43A_sqak1u8o";
const LAT = 48.24872; // Тюдів
const LON = 25.14227;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Родинна дошка</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("family.theme"); } catch (err) {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,700&family=Onest:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.0/dist/umd/supabase.js"></script>
  </head>
  <body data-lat={LAT} data-lon={LON} data-sb-url={SB_URL} data-sb-key={SB_KEY}>
    <header class="top">
      <h1>Родинна дошка</h1>
      <div class="tools">
        <p id="today"></p>
        <button id="theme" type="button" class="ghost"></button>
        <button id="logout" type="button" class="ghost" hidden>Вийти</button>
      </div>
    </header>
    <p id="msg" class="msg" role="status"></p>

    <main class="board">
      <!-- 1. Задачі -->
      <section class="col" aria-labelledby="h-tasks">
        <h2 id="h-tasks">Задачі</h2>

        <form id="task-form" class="task-form">
          <input id="task-text" type="text" placeholder="Нова задача" required maxlength="140" />
          <div class="row">
            <select id="task-person" aria-label="Кому"></select>
            <select id="task-priority" aria-label="Пріоритет">
              <option value="1">Високий</option>
              <option value="2" selected>Середній</option>
              <option value="3">Низький</option>
            </select>
            <button type="submit" class="btn">Додати</button>
          </div>
        </form>

        <div id="filters" class="filters" role="group" aria-label="Фільтр за людиною"></div>
        <ul id="task-list" class="task-list"></ul>
      </section>

      <!-- 2. Нотатки -->
      <section class="col" aria-labelledby="h-notes">
        <h2 id="h-notes">Нотатки</h2>
        
        <form id="note-form" class="task-form">
          <div class="row">
            <input id="note-text" type="text" placeholder="Купити, не забути, ідеї…" required />
            <button type="submit" class="btn">Зберегти</button>
          </div>
        </form>
        
        <ul id="note-list" class="task-list"></ul>
      </section>

      <!-- 3. Погода -->
      <section class="col" aria-labelledby="h-weather">
        <h2 id="h-weather">Погода на 7 днів</h2>
        <ul id="weather" class="weather"><li class="muted">Завантаження…</li></ul>
      </section>
    </main>

    <!-- Вхід -->
    <div id="login" class="login" hidden>
      <form id="login-form" class="login-card">
        <h2>Вхід для родини</h2>
        <input id="email" type="email" placeholder="Email" autocomplete="username" required />
        <input id="password" type="password" placeholder="Пароль" autocomplete="current-password" required />
        <button type="submit" class="btn">Увійти</button>
        <p id="login-err" class="msg" role="alert"></p>
      </form>
    </div>

    <style is:global>
      :root {
        color-scheme: light;
        --bg: #e8eeea;
        --surface: #f8faf8;
        --field: #ffffff;
        --ink: #1b2b27;
        --muted: #5a6c66;
        --line: #c7d2cc;
        --accent: #24473d;
        --on-accent: #ffffff;
        --sunset: #c2561f;
        --p1: #b3402f;
        --p2: #cf9626;
        --p3: #5b8a72;
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #101714;
        --surface: #18221e;
        --field: #0e1512;
        --ink: #e4ece8;
        --muted: #98a9a2;
        --line: #2f3d37;
        --accent: #7fc4a6;
        --on-accent: #0f1c17;
        --sunset: #f08a52;
        --p1: #e0705e;
        --p2: #e0b04a;
        --p3: #7fc4a6;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        margin: 0;
        padding: 20px 24px 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        background: var(--bg);
        color: var(--ink);
        font: 400 15px/1.45 "Onest", system-ui, sans-serif;
      }
      h1, h2 { font-family: "Literata", Georgia, serif; margin: 0; }
      h1 { font-size: 28px; }
      h2 { font-size: 20px; margin-bottom: 14px; }
      .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .tools { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .tools p { margin: 0; color: var(--muted); }
      .muted { color: var(--muted); }
      .msg { margin: -8px 0 0; color: var(--p1); font-size: 13px; }
      .msg:empty { display: none; }

      .board {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }
      .col {
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 20px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
      }

      input, select, textarea, button { font: inherit; color: inherit; }
      input, select, textarea {
        background: var(--field);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 8px 10px;
      }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .btn {
        background: var(--accent);
        color: var(--on-accent);
        border: 0;
        border-radius: 6px;
        padding: 8px 14px;
        cursor: pointer;
        font-weight: 600;
        white-space: nowrap;
      }
      .btn:hover { filter: brightness(1.12); }
      .btn:disabled { opacity: .6; cursor: default; }
      .ghost {
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 14px;
        cursor: pointer;
        font-size: 13px;
      }
      .ghost[hidden] { display: none; }

      /* Вхід */
      .login {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: var(--bg);
      }
      .login[hidden] { display: none; }
      .login-card {
        width: min(360px, 100%);
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 24px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
      }
      .login-card h2 { margin-bottom: 4px; }
      .login-card .msg { margin: 0; }

      /* Задачі та Нотатки */
      .task-form { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
      .task-form .row { display: flex; gap: 8px; }
      .task-form .row input { flex: 1; }
      .task-form select { flex: 1; min-width: 0; }
      .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
      .chip {
        border: 1px solid var(--line);
        background: transparent;
        border-radius: 999px;
        padding: 3px 12px;
        cursor: pointer;
        font-size: 13px;
      }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

      .task-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; min-height: 0; }
      
      .task {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 4px 10px;
        align-items: start;
        padding: 10px 10px 10px 12px;
        margin-bottom: 8px;
        background: var(--field);
        border: 1px solid var(--line);
        border-left: 5px solid var(--p2);
        border-radius: 6px;
      }
      .task[data-p="1"] { border-left-color: var(--p1); }
      .task[data-p="3"] { border-left-color: var(--p3); }
      
      .task-check {
        margin-top: 3px;
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: var(--accent);
      }
      .task .text { font-weight: 500; overflow-wrap: anywhere; }
      .task .meta { grid-column: 2 / -1; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); }
      
      .task[data-s="done"] { opacity: .6; }
      .task[data-s="done"] .text { text-decoration: line-through; color: var(--muted); }
      
      .note-item {
        grid-template-columns: 1fr auto;
        border-left-color: var(--muted);
        align-items: center;
      }
      .note-item .text { grid-column: 1 / 2; font-weight: 400; }

      .del {
        border: 0; background: none; cursor: pointer; color: var(--muted);
        font-size: 18px; line-height: 1; padding: 0 4px;
      }
      .del:hover { color: var(--p1); }
      .empty { color: var(--muted); padding: 8px 0; }

      /* Погода */
      .weather { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; min-height: 0; }
      .day {
        display: grid;
        grid-template-columns: 62px 34px 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid var(--line);
      }
      .day:last-child { border-bottom: 0; }
      .day .name { font-weight: 600; }
      .day .ico { font-size: 24px; text-align: center; }
      .day .desc { font-size: 14px; }
      .day .sub { font-size: 12.5px; color: var(--muted); }
      .day .temp { text-align: right; font-weight: 600; white-space: nowrap; }
      .day .temp span { color: var(--muted); font-weight: 400; }
      .sun { color: var(--sunset); font-weight: 600; }

      @media (max-width: 960px) {
        html, body { height: auto; }
        body { padding: 14px; }
        .board { grid-template-columns: 1fr; }
        .col { min-height: 320px; }
        .task-list, .weather { overflow: visible; }
      }
    </style>

    <script is:inline>
      const PEOPLE = ["Олександр", "Людмила", "Максим", "Антоніна"];
      const PRIORITIES = { 1: "Високий", 2: "Середній", 3: "Низький" };

      const $ = function(id) { return document.getElementById(id); };
      const esc = function(s) {
        return String(s).replace(/[\x26\x3C\x3E\x22\x27]/g, function(c) {
          return { "\x26": "&amp;", "\x3C": "&lt;", "\x3E": "&gt;", "\x22": "&quot;", "\x27": "&#39;" }[c];
        });
      };
      const check = function(res) { if (res.error) throw res.error; };

      const ds = document.body.dataset;
      const sbUrl = ds.sbUrl;
      const sbKey = ds.sbKey;
      const sb = supabase.createClient(sbUrl, sbKey);

      /* ---------- Тема ---------- */
      const themeBtn = $("theme");
      const setTheme = function(t) {
        document.documentElement.dataset.theme = t;
        themeBtn.textContent = t === "dark" ? "Світла тема" : "Темна тема";
      };
      setTheme(document.documentElement.dataset.theme || "light");
      themeBtn.addEventListener("click", function() {
        const t = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        try { localStorage.setItem("family.theme", t); } catch (err) {}
        setTheme(t);
      });

      /* ---------- Дата та повідомлення ---------- */
      $("today").textContent = new Date().toLocaleDateString("uk-UA", {
        weekday: "long", day: "numeric", month: "long", year: "numeric"
      });

      let msgTimer;
      function showMsg(text) {
        $("msg").textContent = text;
        clearTimeout(msgTimer);
        if (text) msgTimer = setTimeout(function() { $("msg").textContent = ""; }, 5000);
      }

      /* ---------- Вхід ---------- */
      let loggedIn = false;
      let tasks = [];
      let notesArray = [];
      let filter = "all";

      function setAuthUi(on) {
        loggedIn = on;
        $("login").hidden = on;
        $("logout").hidden = !on;
      }

      async function init() {
        const res = await sb.auth.getSession();
        setAuthUi(!!res.data.session);
        if (res.data.session) syncAll();
      }

      $("login-form").addEventListener("submit", async function(e) {
        e.preventDefault();
        $("login-err").textContent = "";
        const res = await sb.auth.signInWithPassword({
          email: $("email").value.trim(),
          password: $("password").value
        });
        if (res.error) { $("login-err").textContent = "Невірний email або пароль"; return; }
        $("password").value = "";
        init();
      });

      $("logout").addEventListener("click", function() { sb.auth.signOut(); });

      sb.auth.onAuthStateChange(function(event) {
        if (event === "SIGNED_OUT") {
          tasks = [];
          notesArray = [];
          renderTasks();
          renderNotes();
          setAuthUi(false);
        }
      });

      /* ---------- Задачі ---------- */
      $("task-person").innerHTML = PEOPLE.map(function(p) { return '<option>' + p + '</option>'; }).join("");

      function renderFilters() {
        const items = ["all"].concat(PEOPLE);
        $("filters").innerHTML = items
          .map(function(p) {
            const label = p === "all" ? "Усі" : p;
            const pressed = p === filter ? "true" : "false";
            return '<button type="button" class="chip" data-f="' + p + '" aria-pressed="' + pressed + '">' + label + '</button>';
          })
          .join("");
      }

      function renderTasks() {
        const visible = tasks
          .filter(function(t) { return filter === "all" || t.person === filter; })
          .sort(function(a, b) { return (a.status === "done" ? 1 : 0) - (b.status === "done" ? 1 : 0) || a.priority - b.priority || a.id - b.id; });

        if (visible.length) {
          $("task-list").innerHTML = visible.map(function(t) {
            const isChecked = t.status === 'done' ? 'checked' : '';
            return '<li class="task" data-id="' + t.id + '" data-p="' + t.priority + '" data-s="' + t.status + '">' +
              '<input type="checkbox" class="task-check" data-act="toggle" ' + isChecked + ' aria-label="Відмітити як готове" />' +
              '<span class="text">' + esc(t.text) + '</span>' +
              '<button class="del" data-act="del" aria-label="Видалити задачу">×</button>' +
              '<div class="meta">' +
                '<strong>' + esc(t.person) + '</strong>' +
                '<span>' + PRIORITIES[t.priority] + ' пріоритет</span>' +
              '</div>' +
            '</li>';
          }).join("");
        } else {
          $("task-list").innerHTML = '<li class="empty">Задач немає. Додайте першу вище.</li>';
        }
      }

      async function refreshTasks() {
        const res = await sb.from("family_tasks").select("*").order("id");
        if (res.error) { showMsg("Не вдалося завантажити задачі"); return; }
        tasks = res.data;
        renderTasks();
      }

      $("task-form").addEventListener("submit", async function(e) {
        e.preventDefault();
        const text = $("task-text").value.trim();
        if (!text) return;
        const btn = $("task-form").querySelector("button[type=submit]");
        btn.disabled = true;
        try {
          check(await sb.from("family_tasks").insert({
            text: text,
            person: $("task-person").value,
            priority: Number($("task-priority").value),
            status: "todo"
          }));
          $("task-text").value = "";
          await refreshTasks();
        } catch (err) {
          showMsg("Не вдалося додати задачу");
        } finally {
          btn.disabled = false;
        }
      });

      $("task-list").addEventListener("click", async function(e) {
        const delBtn = e.target.closest("[data-act='del']");
        if (delBtn) {
          const id = Number(delBtn.closest(".task").dataset.id);
          tasks = tasks.filter(function(t) { return t.id !== id; });
          renderTasks();
          try {
            check(await sb.from("family_tasks").delete().eq("id", id));
          } catch (err) {
            await refreshTasks();
            showMsg("Не вдалося видалити задачу");
          }
          return;
        }

        const chk = e.target.closest("[data-act='toggle']");
        if (chk) {
          const id = Number(chk.closest(".task").dataset.id);
          const t = tasks.find(function(t) { return t.id === id; });
          t.status = chk.checked ? "done" : "todo";
          renderTasks();
          try {
            check(await sb.from("family_tasks").update({ status: t.status }).eq("id", id));
          } catch (err) {
            await refreshTasks();
            showMsg("Не вдалося змінити статус");
          }
        }
      });

      $("filters").addEventListener("click", function(e) {
        const b = e.target.closest("[data-f]");
        if (!b) return;
        filter = b.dataset.f;
        renderFilters();
        renderTasks();
      });

      renderFilters();

      /* ---------- Нотатки ---------- */
      function renderNotes() {
        if (notesArray.length) {
          $("note-list").innerHTML = notesArray.map(function(n) {
            return '<li class="task note-item" data-id="' + n.id + '">' +
              '<span class="text">' + esc(n.text) + '</span>' +
              '<button class="del" data-act="del-note" aria-label="Видалити нотатку">×</button>' +
            '</li>';
          }).join("");
        } else {
          $("note-list").innerHTML = '<li class="empty">Нотаток немає.</li>';
        }
      }

      async function refreshNotes() {
        const res = await sb.from("family_notes").select("body").eq("id", 1).maybeSingle();
        if (res.error) { showMsg("Не вдалося завантажити нотатки"); return; }
        
        if (res.data && res.data.body) {
          try {
            notesArray = JSON.parse(res.data.body);
            if (!Array.isArray(notesArray)) throw new Error();
          } catch (err) {
            notesArray = res.data.body.split('\n')
              .map(function(text) { return text.trim(); })
              .filter(function(text) { return text; })
              .map(function(text) { return { id: Date.now() + Math.random(), text: text }; });
          }
        } else {
          notesArray = [];
        }
        renderNotes();
      }

      async function saveNotesToDB() {
        check(await sb.from("family_notes")
          .update({ body: JSON.stringify(notesArray), updated_at: new Date().toISOString() })
          .eq("id", 1));
      }

      $("note-form").addEventListener("submit", async function(e) {
        e.preventDefault();
        const text = $("note-text").value.trim();
        if (!text) return;
        
        const btn = $("note-form").querySelector("button[type=submit]");
        btn.disabled = true;
        
        notesArray.unshift({ id: Date.now(), text: text });
        $("note-text").value = "";
        renderNotes();
        
        try {
          await saveNotesToDB();
        } catch (err) {
          showMsg("Не вдалося зберегти нотатку");
          await refreshNotes();
        } finally {
          btn.disabled = false;
        }
      });

      $("note-list").addEventListener("click", async function(e) {
        const btn = e.target.closest("[data-act='del-note']");
        if (!btn) return;
        
        const id = Number(btn.closest(".note-item").dataset.id);
        notesArray = notesArray.filter(function(n) { return n.id !== id; });
        renderNotes();
        
        try {
          await saveNotesToDB();
        } catch (err) {
          showMsg("Не вдалося видалити нотатку");
          await refreshNotes();
        }
      });

      /* ---------- Синхронізація ---------- */
      function syncAll() {
        if (!loggedIn) return;
        refreshTasks();
        refreshNotes();
      }
      setInterval(function() { if (!document.hidden) syncAll(); }, 30000);
      document.addEventListener("visibilitychange", function() { if (!document.hidden) syncAll(); });
      init();

      /* ---------- Погода (Open-Meteo) ---------- */
      const WMO = function(c) {
        if (c === 0) return ["☀️", "Ясно"];
        if (c <= 2) return ["🌤️", "Мінлива хмарність"];
        if (c === 3) return ["☁️", "Хмарно"];
        if (c <= 48) return ["🌫️", "Туман"];
        if (c <= 57) return ["🌦️", "Мряка"];
        if (c <= 67) return ["🌧️", "Дощ"];
        if (c <= 77) return ["🌨️", "Сніг"];
        if (c <= 82) return ["🌧️", "Злива"];
        if (c <= 86) return ["🌨️", "Снігопад"];
        return ["⛈️", "Гроза"];
      };

      async function loadWeather() {
        const lat = document.body.dataset.lat;
        const lon = document.body.dataset.lon;
        const url = 'https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon + 
          '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunset' + 
          '&timezone=Europe%2FKyiv&forecast_days=7';
          
        try {
          const r = await fetch(url);
          if (!r.ok) throw new Error(r.status);
          const res = await r.json();
          const d = res.daily;
          
          $("weather").innerHTML = d.time.map(function(date, i) {
            const wmoRes = WMO(d.weather_code[i]);
            const ico = wmoRes[0];
            const desc = wmoRes[1];
            const name = i === 0 ? "Сьогодні" : new Date(date + "T12:00").toLocaleDateString("uk-UA", { weekday: "short", day: "numeric" });
            const prob = d.precipitation_probability_max[i] || 0;
            const sun = d.sunset[i].slice(11, 16);
            const tMax = Math.round(d.temperature_2m_max[i]);
            const tMin = Math.round(d.temperature_2m_min[i]);
            
            return '<li class="day">' +
              '<span class="name">' + name + '</span>' +
              '<span class="ico" aria-hidden="true">' + ico + '</span>' +
              '<span>' +
                '<span class="desc">' + desc + '</span><br />' +
                '<span class="sub">опади ' + prob + '% · <span class="sun">захід ' + sun + '</span></span>' +
              '</span>' +
              '<span class="temp">' + tMax + '° <span>' + tMin + '°</span></span>' +
            '</li>';
          }).join("");
        } catch (err) {
          $("weather").innerHTML = '<li class="muted">Не вдалося завантажити погоду. Оновіть сторінку.</li>';
        }
      }
      loadWeather();
    </script>
  </body>
</html>
