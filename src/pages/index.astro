---
const SB_URL = "https://mlkdphygsdfcanztbtez.supabase.co";
const SB_KEY = "sb_publishable_yodMR9SylDv9tF51Y7q43A_sqak1u8o";
const LAT = 48.24872; // Тюдів
const LON = 25.14227;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Родинна дошка</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("family.theme"); } catch (e) {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,700&family=Onest:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.0/dist/umd/supabase.js"></script>
  </head>
  <body data-lat={LAT} data-lon={LON} data-sb-url={SB_URL} data-sb-key={SB_KEY}>
    <header class="top">
      <h1>Родинна дошка</h1>
      <div class="tools">
        <p id="today"></p>
        <button id="theme" type="button" class="ghost"></button>
        <button id="logout" type="button" class="ghost" hidden>Вийти</button>
      </div>
    </header>
    <p id="msg" class="msg" role="status"></p>

    <main class="board">
      <!-- 1. Задачі -->
      <section class="col" aria-labelledby="h-tasks">
        <h2 id="h-tasks">Задачі</h2>

        <form id="task-form" class="task-form">
          <input id="task-text" type="text" placeholder="Нова задача" required maxlength="140" />
          <div class="row">
            <select id="task-person" aria-label="Кому"></select>
            <select id="task-priority" aria-label="Пріоритет">
              <option value="1">Високий</option>
              <option value="2" selected>Середній</option>
              <option value="3">Низький</option>
            </select>
            <button type="submit" class="btn">Додати</button>
          </div>
        </form>

        <div id="filters" class="filters" role="group" aria-label="Фільтр за людиною"></div>
        <ul id="task-list" class="task-list"></ul>
      </section>

      <!-- 2. Нотатки -->
      <section class="col" aria-labelledby="h-notes">
        <h2 id="h-notes">Нотатки</h2>

        <form id="note-form" class="note-form">
          <textarea id="note-text" rows="3" maxlength="5000" placeholder="Нова нотатка…" aria-label="Нова нотатка" required></textarea>
          <button type="submit" class="btn">Додати</button>
        </form>

        <input id="note-search" type="search" placeholder="Пошук по нотатках" aria-label="Пошук по нотатках" />
        <p id="notes-count" class="muted small"></p>
        <ul id="note-list" class="note-list"></ul>
      </section>

      <!-- 3. Погода -->
      <section class="col" aria-labelledby="h-weather">
        <div class="col-head">
          <h2 id="h-weather">Погода на 7 днів</h2>
          <select id="wmodel" aria-label="Модель прогнозу"></select>
        </div>
        <ul id="weather" class="weather"><li class="muted">Завантаження…</li></ul>
        <p id="w-src" class="muted small"></p>
      </section>
    </main>

    <!-- Деталі дня -->
    <dialog id="day-dlg" class="dlg" aria-labelledby="dlg-title">
      <div class="dlg-head">
        <button type="button" id="dlg-prev" class="ghost" aria-label="Попередній день">‹</button>
        <h3 id="dlg-title"></h3>
        <button type="button" id="dlg-next" class="ghost" aria-label="Наступний день">›</button>
        <button type="button" id="dlg-close" class="ghost">Закрити</button>
      </div>
      <div id="dlg-body" class="dlg-body"></div>
    </dialog>

    <!-- Вхід -->
    <div id="login" class="login" hidden>
      <form id="login-form" class="login-card">
        <h2>Вхід для родини</h2>
        <input id="email" type="email" placeholder="Email" autocomplete="username" required />
        <input id="password" type="password" placeholder="Пароль" autocomplete="current-password" required />
        <button type="submit" class="btn">Увійти</button>
        <p id="login-err" class="msg" role="alert"></p>
      </form>
    </div>

    <style is:global>
      :root {
        color-scheme: light;
        --bg: #e8eeea;
        --surface: #f8faf8;
        --field: #ffffff;
        --ink: #1b2b27;
        --muted: #5a6c66;
        --line: #c7d2cc;
        --accent: #24473d;
        --on-accent: #ffffff;
        --sunset: #c2561f;
        --p1: #d92d20;
        --p2: #f0a000;
        --p3: #1f9d55;
        --doing-bg: #f3e2bd;
        --done-bg: #cfe3d8;
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #101714;
        --surface: #18221e;
        --field: #0e1512;
        --ink: #e4ece8;
        --muted: #98a9a2;
        --line: #2f3d37;
        --accent: #7fc4a6;
        --on-accent: #0f1c17;
        --sunset: #f08a52;
        --p1: #ff6b5e;
        --p2: #ffc53d;
        --p3: #3ddc84;
        --doing-bg: #4a3d1c;
        --done-bg: #1f4034;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        margin: 0;
        padding: 20px 24px 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        background: var(--bg);
        color: var(--ink);
        font: 400 15px/1.45 "Onest", system-ui, sans-serif;
      }
      body:has(dialog[open]) { overflow: hidden; }
      h1, h2, h3 { font-family: "Literata", Georgia, serif; margin: 0; }
      h1 { font-size: 28px; }
      h2 { font-size: 20px; margin-bottom: 14px; }
      .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .tools { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .tools p { margin: 0; color: var(--muted); }
      .muted { color: var(--muted); }
      .small { font-size: 13px; }
      .msg { margin: -8px 0 0; color: var(--p1); font-size: 13px; }
      .msg:empty { display: none; }
      .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      .board {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }
      .col {
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 20px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
      }
      .col-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
      .col-head h2 { margin: 0; }
      .col-head select { font-size: 13px; padding: 4px 8px; }

      input, select, textarea, button { font: inherit; color: inherit; }
      input, select, textarea {
        background: var(--field);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 8px 10px;
      }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .btn {
        background: var(--accent);
        color: var(--on-accent);
        border: 0;
        border-radius: 6px;
        padding: 8px 14px;
        cursor: pointer;
        font-weight: 600;
      }
      .btn:hover { filter: brightness(1.12); }
      .btn:disabled { opacity: .6; cursor: default; }
      .ghost {
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 14px;
        cursor: pointer;
        font-size: 13px;
      }
      .ghost:disabled { opacity: .4; cursor: default; }
      .ghost[hidden] { display: none; }
      .link {
        background: none;
        border: 0;
        padding: 4px 0;
        color: var(--muted);
        cursor: pointer;
        font-size: 12.5px;
        text-decoration: underline;
      }
      .link:hover { color: var(--ink); }

      /* Вхід */
      .login {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: var(--bg);
      }
      .login[hidden] { display: none; }
      .login-card {
        width: min(360px, 100%);
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 24px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
      }
      .login-card h2 { margin-bottom: 4px; }
      .login-card .msg { margin: 0; }

      /* Задачі */
      .task-form { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
      .task-form .row { display: flex; gap: 8px; }
      .task-form select { flex: 1; min-width: 0; }
      .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
      .chip {
        border: 1px solid var(--line);
        background: transparent;
        border-radius: 999px;
        padding: 3px 12px;
        cursor: pointer;
        font-size: 13px;
      }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

      .task-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; min-height: 0; }
      .task {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 4px 10px;
        padding: 10px 12px;
        margin-bottom: 10px;
        border: 3px solid var(--p2);
        border-radius: 10px;
        background: color-mix(in srgb, var(--p2) 12%, var(--field));
      }
      .task[data-p="1"] { border-color: var(--p1); background: color-mix(in srgb, var(--p1) 12%, var(--field)); }
      .task[data-p="3"] { border-color: var(--p3); background: color-mix(in srgb, var(--p3) 12%, var(--field)); }
      .task[data-s="done"] { background: var(--field); }
      .task .text { font-weight: 500; overflow-wrap: anywhere; }
      .task .meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); }
      .task[data-s="done"] .text { text-decoration: line-through; color: var(--muted); }
      .status {
        border: 1px solid var(--line);
        background: var(--bg);
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 12px;
        cursor: pointer;
      }
      .task[data-s="doing"] .status { background: var(--doing-bg); border-color: var(--p2); }
      .task[data-s="done"] .status { background: var(--done-bg); border-color: var(--p3); }
      .del {
        border: 0; background: none; cursor: pointer; color: var(--muted);
        font-size: 18px; line-height: 1; padding: 0 4px;
      }
      .del:hover { color: var(--p1); }
      .empty { color: var(--muted); padding: 8px 0; }

      /* Нотатки */
      .note-form { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
      .note-form textarea { resize: vertical; min-height: 72px; line-height: 1.5; }
      .note-form .btn { align-self: flex-end; }
      #note-search { margin-bottom: 6px; }
      #notes-count { margin: 0 0 8px; min-height: 1.3em; }
      .note-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; min-height: 0; }
      .note {
        padding: 10px 12px;
        margin-bottom: 8px;
        background: var(--field);
        border: 1px solid var(--line);
        border-left: 5px solid var(--line);
        border-radius: 6px;
      }
      .note.pinned { border-left-color: var(--accent); }
      .note-text { white-space: pre-wrap; overflow-wrap: anywhere; }
      .note-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 6px;
        font-size: 12.5px;
        color: var(--muted);
      }
      .note-actions { display: flex; gap: 14px; }
      .note.editing textarea { width: 100%; min-height: 90px; margin-bottom: 6px; resize: vertical; line-height: 1.5; }

      /* Погода */
      .weather {
        list-style: none;
        margin: 0;
        padding: 0;
        flex: 1;
        min-height: 0;
        display: grid;
        grid-auto-rows: minmax(52px, 1fr);
        overflow-y: auto;
      }
      .weather > li { display: flex; border-bottom: 1px solid var(--line); }
      .weather > li:last-child { border-bottom: 0; }
      #w-src { margin: 8px 0 0; }
      .day {
        flex: 1;
        width: 100%;
        display: grid;
        grid-template-columns: 58px 30px 1fr auto 12px;
        align-items: center;
        gap: 8px;
        padding: 4px 6px;
        border: 0;
        border-radius: 8px;
        background: none;
        text-align: left;
        cursor: pointer;
      }
      .day:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
      .day .mid, .day .end { display: flex; flex-direction: column; line-height: 1.3; }
      .day .end { align-items: flex-end; }
      .day .name { font-weight: 600; font-size: 14px; }
      .day .ico { font-size: 22px; text-align: center; }
      .day .desc { font-size: 14px; }
      .day .sub { font-size: 12.5px; color: var(--muted); }
      .day .temp { font-weight: 600; white-space: nowrap; }
      .day .temp span { color: var(--muted); font-weight: 400; }
      .day .sun { color: var(--sunset); font-weight: 600; white-space: nowrap; }
      .day .chev { color: var(--muted); font-size: 18px; text-align: right; }

      /* Деталі дня */
      dialog.dlg {
        width: min(520px, calc(100vw - 24px));
        max-height: min(700px, calc(100dvh - 24px));
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
        color: var(--ink);
        overflow: auto;
      }
      dialog.dlg[open] { display: flex; flex-direction: column; }
      dialog.dlg::backdrop { background: rgba(0, 0, 0, .5); }
      .dlg-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--line);
      }
      .dlg-head h3 { flex: 1; font-size: 18px; }
      .dlg-body { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 14px 16px 16px; }
      .dlg-sum { margin: 0 0 10px; font-size: 16px; font-weight: 600; }
      .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
      .stat { padding: 8px 10px; background: var(--field); border: 1px solid var(--line); border-radius: 8px; }
      .stat .k { font-size: 12px; color: var(--muted); }
      .stat .v { font-weight: 600; }
      .stat .s { font-size: 12px; color: var(--muted); }
      .hours { list-style: none; margin: 0; padding: 0; flex: 1; min-height: 200px; overflow-y: auto; position: relative; }
      .hr {
        display: grid;
        grid-template-columns: 44px 26px 40px 1fr auto;
        align-items: center;
        gap: 8px;
        padding: 6px 6px;
        border-bottom: 1px solid var(--line);
        font-size: 13.5px;
      }
      .hr .ico { text-align: center; }
      .hr .tmp { font-weight: 600; }
      .hr .pr, .hr .wd { color: var(--muted); }
      .hr .wd { text-align: right; white-space: nowrap; }
      .hr.now { background: color-mix(in srgb, var(--accent) 16%, transparent); border-radius: 6px; font-weight: 600; }

      @media (max-width: 960px) {
        html, body { height: auto; }
        body { padding: 14px; }
        .board { grid-template-columns: 1fr; }
        .col { min-height: 320px; }
        .task-list, .note-list { overflow: visible; }
        .weather { overflow: visible; grid-auto-rows: auto; }
        .day { padding: 8px 6px; }
      }
    </style>

    <script is:inline>
      const PEOPLE = ["Олександр", "Людмила", "Максим", "Антоніна"];
      const PRIORITIES = { 1: "Високий", 2: "Середній", 3: "Низький" };
      const STATUSES = { todo: "До виконання", doing: "В роботі", done: "Готово" };
      const NEXT = { todo: "doing", doing: "done", done: "todo" };
      const T_TASKS = "family_tasks";
      const T_NOTES = "family_note_items";

      const $ = (id) => document.getElementById(id);
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      const check = ({ error }) => { if (error) throw error; };

      const { sbUrl, sbKey } = document.body.dataset;
      const sb = supabase.createClient(sbUrl, sbKey);

      /* ---------- Тема ---------- */
      const themeBtn = $("theme");
      const setTheme = (t) => {
        document.documentElement.dataset.theme = t;
        themeBtn.textContent = t === "dark" ? "Світла тема" : "Темна тема";
      };
      setTheme(document.documentElement.dataset.theme || "light");
      themeBtn.addEventListener("click", () => {
        const t = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        try { localStorage.setItem("family.theme", t); } catch {}
        setTheme(t);
      });

      /* ---------- Дата та повідомлення ---------- */
      $("today").textContent = new Date().toLocaleDateString("uk-UA", {
        weekday: "long", day: "numeric", month: "long", year: "numeric",
      });

      let msgTimer;
      function showMsg(text) {
        $("msg").textContent = text;
        clearTimeout(msgTimer);
        if (text) msgTimer = setTimeout(() => ($("msg").textContent = ""), 5000);
      }

      /* ---------- Вхід ---------- */
      let loggedIn = false;
      let tasks = [];
      let filter = "all";
      let notes = [];
      let noteQuery = "";
      let editingId = null;

      function setAuthUi(on) {
        loggedIn = on;
        $("login").hidden = on;
        $("logout").hidden = !on;
      }

      async function init() {
        const { data } = await sb.auth.getSession();
        setAuthUi(!!data.session);
        if (data.session) syncAll();
      }

      $("login-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        $("login-err").textContent = "";
        const { error } = await sb.auth.signInWithPassword({
          email: $("email").value.trim(),
          password: $("password").value,
        });
        if (error) { $("login-err").textContent = "Невірний email або пароль"; return; }
        $("password").value = "";
        init();
      });

      $("logout").addEventListener("click", () => sb.auth.signOut());

      sb.auth.onAuthStateChange((event) => {
        if (event === "SIGNED_OUT") {
          tasks = [];
          notes = [];
          editingId = null;
          renderTasks();
          renderNotes();
          setAuthUi(false);
