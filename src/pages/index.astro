---
const SB_URL = "https://mlkdphygsdfcanztbtez.supabase.co";
const SB_KEY = "sb_publishable_yodMR9SylDv9tF51Y7q43A_sqak1u8o";
const LAT = 48.24872; // Тюдів
const LON = 25.14227;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Родинна дошка</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("family.theme"); } catch (e) {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,700&family=Onest:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.0/dist/umd/supabase.js"></script>
  </head>
  <body data-lat={LAT} data-lon={LON} data-sb-url={SB_URL} data-sb-key={SB_KEY}>
    <header class="top">
      <h1>Родинна дошка</h1>
      <div class="tools">
        <p id="today"></p>
        <button id="theme" type="button" class="ghost"></button>
        <button id="logout" type="button" class="ghost" hidden>Вийти</button>
      </div>
    </header>
    <p id="msg" class="msg" role="status"></p>

    <main class="board">
      <!-- 1. Задачі -->
      <section class="col" aria-labelledby="h-tasks">
        <h2 id="h-tasks">Задачі</h2>

        <form id="task-form" class="task-form">
          <input id="task-text" type="text" placeholder="Нова задача" required maxlength="140" />
          <div class="row">
            <select id="task-person" aria-label="Кому"></select>
            <select id="task-priority" aria-label="Пріоритет">
              <option value="1">Високий</option>
              <option value="2" selected>Середній</option>
              <option value="3">Низький</option>
            </select>
            <button type="submit" class="btn">Додати</button>
          </div>
        </form>

        <div id="filters" class="filters" role="group" aria-label="Фільтр за людиною"></div>
        <ul id="task-list" class="task-list"></ul>
      </section>

      <!-- 2. Нотатки -->
      <section class="col" aria-labelledby="h-notes">
        <h2 id="h-notes">Нотатки</h2>
        <textarea id="notes" placeholder="Купити, не забути, ідеї…" aria-label="Нотатки"></textarea>
        <p id="notes-state" class="muted small" aria-live="polite"></p>
      </section>

      <!-- 3. Погода -->
      <section class="col" aria-labelledby="h-weather">
        <h2 id="h-weather">Погода на 7 днів</h2>
        <ul id="weather" class="weather"><li class="muted">Завантаження…</li></ul>
      </section>
    </main>

    <!-- Вхід -->
    <div id="login" class="login" hidden>
      <form id="login-form" class="login-card">
        <h2>Вхід для родини</h2>
        <input id="email" type="email" placeholder="Email" autocomplete="username" required />
        <input id="password" type="password" placeholder="Пароль" autocomplete="current-password" required />
        <button type="submit" class="btn">Увійти</button>
        <p id="login-err" class="msg" role="alert"></p>
      </form>
    </div>

    <style is:global>
      :root {
        color-scheme: light;
        --bg: #e8eeea;
        --surface: #f8faf8;
        --field: #ffffff;
        --ink: #1b2b27;
        --muted: #5a6c66;
        --line: #c7d2cc;
        --accent: #24473d;
        --on-accent: #ffffff;
        --sunset: #c2561f;
        --p1: #b3402f;
        --p2: #cf9626;
        --p3: #5b8a72;
        --doing-bg: #f3e2bd;
        --done-bg: #cfe3d8;
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #101714;
        --surface: #18221e;
        --field: #0e1512;
        --ink: #e4ece8;
        --muted: #98a9a2;
        --line: #2f3d37;
        --accent: #7fc4a6;
        --on-accent: #0f1c17;
        --sunset: #f08a52;
        --p1: #e0705e;
        --p2: #e0b04a;
        --p3: #7fc4a6;
        --doing-bg: #4a3d1c;
        --done-bg: #1f4034;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        margin: 0;
        padding: 20px 24px 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        background: var(--bg);
        color: var(--ink);
        font: 400 15px/1.45 "Onest", system-ui, sans-serif;
      }
      h1, h2 { font-family: "Literata", Georgia, serif; margin: 0; }
      h1 { font-size: 28px; }
      h2 { font-size: 20px; margin-bottom: 14px; }
      .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .tools { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .tools p { margin: 0; color: var(--muted); }
      .muted { color: var(--muted); }
      .small { font-size: 13px; }
      .msg { margin: -8px 0 0; color: var(--p1); font-size: 13px; }
      .msg:empty { display: none; }

      .board {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }
      .col {
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 20px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
      }

      input, select, textarea, button { font: inherit; color: inherit; }
      input, select, textarea {
        background: var(--field);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 8px 10px;
      }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .btn {
        background: var(--accent);
        color: var(--on-accent);
        border: 0;
        border-radius: 6px;
        padding: 8px 14px;
        cursor: pointer;
        font-weight: 600;
      }
      .btn:hover { filter: brightness(1.12); }
      .btn:disabled { opacity: .6; cursor: default; }
      .ghost {
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 14px;
        cursor: pointer;
        font-size: 13px;
      }
      .ghost[hidden] { display: none; }

      /* Вхід */
      .login {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: var(--bg);
      }
      .login[hidden] { display: none; }
      .login-card {
        width: min(360px, 100%);
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 24px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
      }
      .login-card h2 { margin-bottom: 4px; }
      .login-card .msg { margin: 0; }

      /* Задачі */
      .task-form { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
      .task-form .row { display: flex; gap: 8px; }
      .task-form select { flex: 1; min-width: 0; }
      .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
      .chip {
        border: 1px solid var(--line);
        background: transparent;
        border-radius: 999px;
        padding: 3px 12px;
        cursor: pointer;
        font-size: 13px;
      }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

      .task-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; min-height: 0; }
      .task {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 4px 10px;
        padding: 10px 10px 10px 14px;
        margin-bottom: 8px;
        background: var(--field);
        border: 1px solid var(--line);
        border-left: 5px solid var(--p2);
        border-radius: 6px;
      }
      .task[data-p="1"] { border-left-color: var(--p1); }
      .task[data-p="3"] { border-left-color: var(--p3); }
      .task .text { font-weight: 500; overflow-wrap: anywhere; }
      .task .meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); }
      .task[data-s="done"] .text { text-decoration: line-through; color: var(--muted); }
      .task[data-s="done"] { opacity: .7; }
      .status {
        border: 1px solid var(--line);
        background: var(--bg);
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 12px;
        cursor: pointer;
      }
      .task[data-s="doing"] .status { background: var(--doing-bg); border-color: var(--p2); }
      .task[data-s="done"] .status { background: var(--done-bg); border-color: var(--p3); }
      .del {
        border: 0; background: none; cursor: pointer; color: var(--muted);
        font-size: 18px; line-height: 1; padding: 0 4px;
      }
      .del:hover { color: var(--p1); }
      .empty { color: var(--muted); padding: 8px 0; }

      /* Нотатки */
      #notes { flex: 1; min-height: 160px; resize: none; line-height: 1.55; }
      #notes-state { margin: 8px 0 0; min-height: 1.4em; }

      /* Погода */
      .weather { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; min-height: 0; }
      .day {
        display: grid;
        grid-template-columns: 62px 34px 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid var(--line);
      }
      .day:last-child { border-bottom: 0; }
      .day .name { font-weight: 600; }
      .day .ico { font-size: 24px; text-align: center; }
      .day .desc { font-size: 14px; }
      .day .sub { font-size: 12.5px; color: var(--muted); }
      .day .temp { text-align: right; font-weight: 600; white-space: nowrap; }
      .day .temp span { color: var(--muted); font-weight: 400; }
      .sun { color: var(--sunset); font-weight: 600; }

      @media (max-width: 960px) {
        html, body { height: auto; }
        body { padding: 14px; }
        .board { grid-template-columns: 1fr; }
        .col { min-height: 320px; }
        .task-list, .weather { overflow: visible; }
        #notes { min-height: 240px; }
      }
    </style>

    <script is:inline>
      const PEOPLE = ["Олександр", "Людмила", "Максим", "Антоніна"];
      const PRIORITIES = { 1: "Високий", 2: "Середній", 3: "Низький" };
      const STATUSES = { todo: "До виконання", doing: "В роботі", done: "Готово" };
      const NEXT = { todo: "doing", doing: "done", done: "todo" };

      const $ = (id) => document.getElementById(id);
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      const check = ({ error }) => { if (error) throw error; };

      const { sbUrl, sbKey } = document.body.dataset;
      const sb = supabase.createClient(sbUrl, sbKey);

      /* ---------- Тема ---------- */
      const themeBtn = $("theme");
      const setTheme = (t) => {
        document.documentElement.dataset.theme = t;
        themeBtn.textContent = t === "dark" ? "Світла тема" : "Темна тема";
      };
      setTheme(document.documentElement.dataset.theme || "light");
      themeBtn.addEventListener("click", () => {
        const t = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        try { localStorage.setItem("family.theme", t); } catch {}
        setTheme(t);
      });

      /* ---------- Дата та повідомлення ---------- */
      $("today").textContent = new Date().toLocaleDateString("uk-UA", {
        weekday: "long", day: "numeric", month: "long", year: "numeric",
      });

      let msgTimer;
      function showMsg(text) {
        $("msg").textContent = text;
        clearTimeout(msgTimer);
        if (text) msgTimer = setTimeout(() => ($("msg").textContent = ""), 5000);
      }

      /* ---------- Вхід ---------- */
      let loggedIn = false;
      let tasks = [];
      let filter = "all";
      const notes = $("notes");
      let notesDirty = false;

      function setAuthUi(on) {
        loggedIn = on;
        $("login").hidden = on;
        $("logout").hidden = !on;
      }

      async function init() {
        const { data } = await sb.auth.getSession();
        setAuthUi(!!data.session);
        if (data.session) syncAll();
      }

      $("login-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        $("login-err").textContent = "";
        const { error } = await sb.auth.signInWithPassword({
          email: $("email").value.trim(),
          password: $("password").value,
        });
        if (error) { $("login-err").textContent = "Невірний email або пароль"; return; }
        $("password").value = "";
        init();
      });

      $("logout").addEventListener("click", () => sb.auth.signOut());

      sb.auth.onAuthStateChange((event) => {
        if (event === "SIGNED_OUT") {
          tasks = [];
          renderTasks();
          notes.value = "";
          setAuthUi(false);
        }
      });

      /* ---------- Задачі ---------- */
      $("task-person").innerHTML = PEOPLE.map((p) => `<option>${p}</option>`).join("");

      function renderFilters() {
        const items = ["all", ...PEOPLE];
        $("filters").innerHTML = items
          .map((p) => `<button type="button" class="chip" data-f="${p}" aria-pressed="${p === filter}">${p === "all" ? "Усі" : p}</button>`)
          .join("");
      }

      function renderTasks() {
        const visible = tasks
          .filter((t) => filter === "all" || t.person === filter)
          .sort((a, b) => (a.status === "done") - (b.status === "done") || a.priority - b.priority || a.id - b.id);

        $("task-list").innerHTML = visible.length
          ? visible.map((t) => `
            <li class="task" data-id="${t.id}" data-p="${t.priority}" data-s="${t.status}">
              <span class="text">${esc(t.text)}</span>
              <button class="del" data-act="del" aria-label="Видалити задачу">×</button>
              <div class="meta">
                <strong>${esc(t.person)}</strong>
                <span>${PRIORITIES[t.priority]} пріоритет</span>
                <button class="status" data-act="next" title="Змінити статус">${STATUSES[t.status]}</button>
              </div>
            </li>`).join("")
          : `<li class="empty">Задач немає. Додайте першу вище.</li>`;
      }

      async function refreshTasks() {
        const { data, error } = await sb.from("family_tasks").select("*").order("id");
        if (error) { showMsg("Не вдалося завантажити задачі"); return; }
        tasks = data;
        renderTasks();
      }

      $("task-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const text = $("task-text").value.trim();
        if (!text) return;
        const btn = $("task-form").querySelector("button[type=submit]");
        btn.disabled = true;
        try {
          check(await sb.from("family_tasks").insert({
            text,
            person: $("task-person").value,
            priority: Number($("task-priority").value),
          }));
          $("task-text").value = "";
          await refreshTasks();
        } catch {
          showMsg("Не вдалося додати задачу");
        } finally {
          btn.disabled = false;
        }
      });

      $("task-list").addEventListener("click", async (e) => {
        const btn = e.target.closest("[data-act]");
        if (!btn) return;
        const id = Number(btn.closest(".task").dataset.id);
        try {
          if (btn.dataset.act === "del") {
            tasks = tasks.filter((t) => t.id !== id);
            renderTasks();
            check(await sb.from("family_tasks").delete().eq("id", id));
          } else {
            const t = tasks.find((t) => t.id === id);
            t.status = NEXT[t.status];
            renderTasks();
            check(await sb.from("family_tasks").update({ status: t.status }).eq("id", id));
          }
        } catch {
          await refreshTasks();
          showMsg("Не вдалося зберегти зміну");
        }
      });

      $("filters").addEventListener("click", (e) => {
        const b = e.target.closest("[data-f]");
        if (!b) return;
        filter = b.dataset.f;
        renderFilters();
        renderTasks();
      });

      renderFilters();
      renderTasks();

      /* ---------- Нотатки ---------- */
      let notesTimer;

      async function refreshNotes() {
        if (document.activeElement === notes || notesDirty) return;
        const { data, error } = await sb.from("family_notes").select("body").eq("id", 1).maybeSingle();
        if (error) { showMsg("Не вдалося завантажити нотатки"); return; }
        if (data) notes.value = data.body;
      }

      notes.addEventListener("input", () => {
        notesDirty = true;
        $("notes-state").textContent = "Збереження…";
        clearTimeout(notesTimer);
        notesTimer = setTimeout(async () => {
          try {
            check(await sb.from("family_notes")
              .update({ body: notes.value, updated_at: new Date().toISOString() })
              .eq("id", 1));
            notesDirty = false;
            $("notes-state").textContent = "Збережено";
          } catch {
            $("notes-state").textContent = "Не збережено, перевірте зв'язок";
          }
        }, 600);
      });

      /* ---------- Синхронізація ---------- */
      function syncAll() {
        if (!loggedIn) return;
        refreshTasks();
        refreshNotes();
      }
      setInterval(() => { if (!document.hidden) syncAll(); }, 30000);
      document.addEventListener("visibilitychange", () => { if (!document.hidden) syncAll(); });
      init();

      /* ---------- Погода (Open-Meteo, без ключа) ---------- */
      const WMO = (c) => {
        if (c === 0) return ["☀️", "Ясно"];
        if (c <= 2) return ["🌤️", "Мінлива хмарність"];
        if (c === 3) return ["☁️", "Хмарно"];
        if (c <= 48) return ["🌫️", "Туман"];
        if (c <= 57) return ["🌦️", "Мряка"];
        if (c <= 67) return ["🌧️", "Дощ"];
        if (c <= 77) return ["🌨️", "Сніг"];
        if (c <= 82) return ["🌧️", "Злива"];
        if (c <= 86) return ["🌨️", "Снігопад"];
        return ["⛈️", "Гроза"];
      };

      async function loadWeather() {
        const { lat, lon } = document.body.dataset;
        const url =
          `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}` +
          `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunset` +
          `&timezone=Europe%2FKyiv&forecast_days=7`;
        try {
          const r = await fetch(url);
          if (!r.ok) throw new Error(r.status);
          const d = (await r.json()).daily;
          $("weather").innerHTML = d.time.map((date, i) => {
            const [ico, desc] = WMO(d.weather_code[i]);
            const name = i === 0 ? "Сьогодні" : new Date(date + "T12:00").toLocaleDateString("uk-UA", { weekday: "short", day: "numeric" });
            return `
              <li class="day">
                <span class="name">${name}</span>
                <span class="ico" aria-hidden="true">${ico}</span>
                <span>
                  <span class="desc">${desc}</span><br />
                  <span class="sub">опади ${d.precipitation_probability_max[i] ?? 0}% · <span class="sun">захід ${d.sunset[i].slice(11, 16)}</span></span>
                </span>
                <span class="temp">${Math.round(d.temperature_2m_max[i])}° <span>${Math.round(d.temperature_2m_min[i])}°</span></span>
              </li>`;
          }).join("");
        } catch {
          $("weather").innerHTML = `<li class="muted">Не вдалося завантажити погоду. Оновіть сторінку.</li>`;
        }
      }
      loadWeather();
    </script>
  </body>
</html>
